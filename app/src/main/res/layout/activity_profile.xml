<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A1F">

    <!-- Обложка -->
    <ImageView
        android:id="@+id/profileCover"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_user_placeholder"
        android:alpha="0.9"
        android:contentDescription="Cover Image"/>

    <!-- Top Bar -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="40dp"
        android:paddingBottom="10dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:elevation="10dp"
        android:translationZ="10dp">

        <!-- Back Button -->
        <LinearLayout
            android:id="@+id/exit_profile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_stat_pill"
            android:backgroundTint="#E0E0E0"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_back"
                app:tint="#000000"
                android:contentDescription="Back"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BACK"
                android:textSize="8sp"
                android:textStyle="bold"
                android:textColor="#000000"/>
        </LinearLayout>

        <!-- Username Title -->
        <TextView
            android:id="@+id/userID"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@midkpi"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:shadowColor="#000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"/>

        <!-- Settings Button -->
        <FrameLayout
            android:id="@+id/btnSettings"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/circle_white_bg"
            android:backgroundTint="#E0E0E0"
            android:padding="10dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_settings"
                app:tint="#000000"
                android:contentDescription="Settings"/>
        </FrameLayout>
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="80dp"
        android:clipToPadding="false"
        android:fillViewport="true">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="60dp">

                <!-- Main Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/profileCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#E6E6E6"
                    app:cardCornerRadius="32dp"
                    app:cardElevation="0dp"
                    android:layout_marginBottom="-32dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingTop="70dp"
                        android:paddingBottom="40dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <!-- Name -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/profileUsername"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Илья ким"
                                android:textColor="#000000"
                                android:textSize="24sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" 😎"
                                android:textColor="#000000"
                                android:textSize="24sp"/>
                        </LinearLayout>

                        <!-- Status -->
                        <TextView
                            android:id="@+id/status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Все только начинается"
                            android:textColor="#000000"
                            android:textSize="14sp"
                            android:textStyle="bold"/>

                        <!-- Stats Pills Row -->
                        <LinearLayout
                            android:id="@+id/statsCard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <!-- Subscribers -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/bg_stat_pill"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:paddingVertical="8dp"
                                android:layout_marginEnd="8dp">
                                <TextView
                                    android:id="@+id/subsCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="356k"
                                    android:textColor="#FFFFFF"
                                    android:textSize="16sp"
                                    android:textStyle="bold"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Подписчики"
                                    android:textColor="#000000"
                                    android:textSize="11sp"
                                    android:textStyle="bold"/>
                            </LinearLayout>

                            <!-- Friends -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/bg_stat_pill"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:paddingVertical="8dp"
                                android:layout_marginEnd="8dp">
                                <TextView
                                    android:id="@+id/friendsCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="256"
                                    android:textColor="#FFFFFF"
                                    android:textSize="16sp"
                                    android:textStyle="bold"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Друзья"
                                    android:textColor="#000000"
                                    android:textSize="11sp"
                                    android:textStyle="bold"/>
                            </LinearLayout>

                            <!-- Following -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/bg_stat_pill"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:paddingVertical="8dp">
                                <TextView
                                    android:id="@+id/photoCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="1"
                                    android:textColor="#FFFFFF"
                                    android:textSize="16sp"
                                    android:textStyle="bold"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Подписки"
                                    android:textColor="#000000"
                                    android:textSize="11sp"
                                    android:textStyle="bold"/>
                            </LinearLayout>

                        </LinearLayout>

                        <!-- Bottom Content Section -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:backgroundTint="#C0C0C0"
                            app:cardCornerRadius="32dp"
                            app:cardElevation="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <!-- Tabs -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_stat_pill"
                                    android:backgroundTint="#909090"
                                    android:orientation="horizontal"
                                    android:padding="4dp"
                                    android:weightSum="5">
                                    
                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:gravity="center"
                                        android:text="Фото"
                                        android:background="@drawable/bg_stat_pill"
                                        android:backgroundTint="#E0E0E0"
                                        android:textColor="#000000"
                                        android:padding="6dp"
                                        android:textSize="12sp"
                                        android:textStyle="bold"/>
                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:gravity="center"
                                        android:text="Музыка"
                                        android:textColor="#303030"
                                        android:textSize="12sp"/>
                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:gravity="center"
                                        android:text="Видео"
                                        android:textColor="#303030"
                                        android:textSize="12sp"/>
                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:gravity="center"
                                        android:text="Альбомы"
                                        android:textSize="10sp"
                                        android:textColor="#303030"/>
                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:gravity="center"
                                        android:text="Статьи"
                                        android:textColor="#303030"
                                        android:textSize="12sp"/>
                                </LinearLayout>

                                <!-- Grid Placeholder -->
                                <androidx.cardview.widget.CardView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:backgroundTint="#909090"
                                    app:cardCornerRadius="24dp"
                                    app:cardElevation="0dp">

                                    <GridLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:columnCount="4"
                                        android:rowCount="2"
                                        android:padding="12dp"
                                        android:useDefaultMargins="false"
                                        android:alignmentMode="alignMargins">

                                        <!-- Row 1 -->
                                        <androidx.cardview.widget.CardView
                                            android:layout_width="0dp"
                                            android:layout_height="60dp"
                                            android:layout_columnWeight="1"
                                            android:layout_margin="6dp"
                                            app:cardCornerRadius="12dp"
                                            app:cardElevation="0dp"
                                            app:cardBackgroundColor="#D0D0D0"/>
                                        <androidx.cardview.widget.CardView
                                            android:layout_width="0dp"
                                            android:layout_height="60dp"
                                            android:layout_columnWeight="1"
                                            android:layout_margin="6dp"
                                            app:cardCornerRadius="12dp"
                                            app:cardElevation="0dp"
                                            app:cardBackgroundColor="#D0D0D0"/>
                                        <androidx.cardview.widget.CardView
                                            android:layout_width="0dp"
                                            android:layout_height="60dp"
                                            android:layout_columnWeight="1"
                                            android:layout_margin="6dp"
                                            app:cardCornerRadius="12dp"
                                            app:cardElevation="0dp"
                                            app:cardBackgroundColor="#D0D0D0"/>
                                        <androidx.cardview.widget.CardView
                                            android:layout_width="0dp"
                                            android:layout_height="60dp"
                                            android:layout_columnWeight="1"
                                            android:layout_margin="6dp"
                                            app:cardCornerRadius="12dp"
                                            app:cardElevation="0dp"
                                            app:cardBackgroundColor="#D0D0D0"/>

                                        <!-- Row 2 -->
                                        <androidx.cardview.widget.CardView
                                            android:layout_width="0dp"
                                            android:layout_height="60dp"
                                            android:layout_columnWeight="1"
                                            android:layout_margin="6dp"
                                            app:cardCornerRadius="12dp"
                                            app:cardElevation="0dp"
                                            app:cardBackgroundColor="#D0D0D0"/>
                                        <androidx.cardview.widget.CardView
                                            android:layout_width="0dp"
                                            android:layout_height="60dp"
                                            android:layout_columnWeight="1"
                                            android:layout_margin="6dp"
                                            app:cardCornerRadius="12dp"
                                            app:cardElevation="0dp"
                                            app:cardBackgroundColor="#D0D0D0"/>
                                        <androidx.cardview.widget.CardView
                                            android:layout_width="0dp"
                                            android:layout_height="60dp"
                                            android:layout_columnWeight="1"
                                            android:layout_margin="6dp"
                                            app:cardCornerRadius="12dp"
                                            app:cardElevation="0dp"
                                            app:cardBackgroundColor="#D0D0D0"/>
                                        <androidx.cardview.widget.CardView
                                            android:layout_width="0dp"
                                            android:layout_height="60dp"
                                            android:layout_columnWeight="1"
                                            android:layout_margin="6dp"
                                            app:cardCornerRadius="12dp"
                                            app:cardElevation="0dp"
                                            app:cardBackgroundColor="#D0D0D0"/>

                                    </GridLayout>
                                </androidx.cardview.widget.CardView>

                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <!-- Create Post Button -->
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnCreatePost"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="32dp"
                            android:text="Создать пост"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="#FFFFFF"
                            android:background="@drawable/bg_stat_pill"
                            android:backgroundTint="#808080"/>
                        
                        <!-- Test Posts -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="20dp">
                            
                            <include layout="@layout/item_post_card"/>
                            <include layout="@layout/item_post_card"/>
                            <include layout="@layout/item_post_card"/>
                            <include layout="@layout/item_post_card"/>
                            <include layout="@layout/item_post_card"/>
                            
                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Space at bottom -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:background="#E6E6E6"/>
            </LinearLayout>

            <!-- Avatar - Positioned absolutely within RelativeLayout -->
            <FrameLayout
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:layout_marginTop="0dp"
                android:layout_centerHorizontal="true"
                android:elevation="10dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/profileAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="5dp"
                    android:background="@drawable/circle_white_bg"
                    android:backgroundTint="#E6E6E6"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_user_placeholder"
                    app:shapeAppearanceOverlay="@style/AvatarRound"
                    android:contentDescription="Avatar"/>
            </FrameLayout>

        </RelativeLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
