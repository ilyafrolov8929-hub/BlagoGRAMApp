<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000A0A1F"
    android:fitsSystemWindows="true"
    android:animateLayoutChanges="true"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/chatHeader"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="#1A1A33">

        <!-- Контейнер контента (выровнен по нижнему краю) -->
        <LinearLayout
            android:id="@+id/headerContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="#454545"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="17dp">

            <ImageView
                android:id="@+id/backBtn"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_back"
                app:tint="#FFFFFF" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/chatAvatar"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_marginStart="12dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_user_placeholder"
                app:shapeAppearanceOverlay="@style/AvatarRound" />

            <TextView
                android:id="@+id/chatName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Имя пользователя"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

        </LinearLayout>

    </RelativeLayout>


    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ФОН (фиксированный, не сжимается) -->

        <ImageView
            android:id="@+id/chatBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:src="@drawable/background" />

        <!-- Сообщения (скроллятся) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/messagesList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="12dp" />

        <TextView
            android:id="@+id/emptyMessagesText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="20dp"
            android:text="Здесь ничего нет, отправьте сообщение первым!"
            android:textColor="#80FFFFFF"
            android:textSize="16sp"
            android:visibility="gone" />

    </FrameLayout>

    <!-- ATTACHMENTS PREVIEW -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/attachmentsPreview"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#2A2A2A"
        android:visibility="gone" />

    <!-- INPUT BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#454545"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Поле для ввода -->
        <EditText
            android:id="@+id/messageInput"
            android:layout_width="278dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/input_bg_modern"
            android:gravity="top|start"
            android:hint="Сообщение..."
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="5"
            android:overScrollMode="ifContentScrolls"

            android:padding="14dp"
            android:scrollbars="vertical"

            android:scrollHorizontally="false"
            android:textColor="#FFFFFF"
            android:textColorHint="#525252"
            android:textSize="17sp" />


        <ImageView
            android:id="@+id/attachBtn"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:padding="10dp"
            android:src="@drawable/ic_sendfile"
            app:tint="#A9A8A8" />

        <ImageView
            android:id="@+id/sendBtn"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:padding="10dp"
            android:src="@drawable/ic_send"
            app:tint="#A9A8A8" />

    </LinearLayout>


</LinearLayout>
