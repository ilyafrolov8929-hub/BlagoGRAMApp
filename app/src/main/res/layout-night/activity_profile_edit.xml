<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A1F">

    <!-- Верхняя панель -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnBackProfileEdit"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="6dp"
            android:src="@drawable/ic_back"
            android:tint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:text="Редактирование"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"/>
    </RelativeLayout>


    <!-- ОСНОВНАЯ ЛЕНТА -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:layout_marginTop="56dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- АВАТАР -->
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/editAvatar"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_user_placeholder"
                    app:shapeAppearanceOverlay="@style/AvatarRound"
                    android:padding="0dp"/>

                <!-- Кнопка изменить -->
                <ImageView
                    android:id="@+id/editAvatarBtn"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_alignBottom="@id/editAvatar"
                    android:layout_alignEnd="@id/editAvatar"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/avatar_edit_bg"
                    android:padding="10dp"
                    android:src="@drawable/ic_edit"
                    android:tint="#FFFFFF"/>
            </RelativeLayout>


            <!-- КАРТОЧКА — основные данные -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg_light"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginTop="20dp">

                <TextView
                    android:layout_width="269dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Основная информация"
                    android:textColor="#8FA0C0"
                    android:textSize="14sp" />

                <!-- Имя -->
                <EditText
                    android:id="@+id/editName"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/edit_vk"
                    android:hint="Имя"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#80FFFFFF"
                    android:paddingStart="14dp"/>

                <!-- Статус -->
                <EditText
                    android:id="@+id/editStatus"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/edit_vk"
                    android:hint="Статус"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#80FFFFFF"
                    android:paddingStart="14dp"/>
            </LinearLayout>


            <!-- КНОПКА СОХРАНИТЬ -->
            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/btn_vk"
                android:text="СОХРАНИТЬ"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>
                
            <!-- КНОПКА ВЫЙТИ -->
            <TextView
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Выйти из аккаунта"
                android:textColor="#FF4444"
                android:textSize="16sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
