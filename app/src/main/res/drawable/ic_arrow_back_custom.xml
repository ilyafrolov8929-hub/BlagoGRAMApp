<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Используем stroke (обводку) вместо fill (заливки) для легкого скругления -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M19,12H5M12,19l-7,-7 7,-7" />

    <!--
      Изменения:
      1. strokeLineCap="round" — скругляет концы линий.
      2. strokeLineJoin="round" — скругляет места соединения линий (уголок стрелки).
      3. strokeWidth="2" — толщина линии (стандартная для иконок).
      4. pathData — упрощенный путь стрелки, адаптированный под обводку.
    -->
</vector>
